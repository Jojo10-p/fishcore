    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.9.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.65.0",
    "next": "^15.5.28",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
