# ─────────────────────────────────────────────
# fishcore — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local dans git
# ─────────────────────────────────────────────

# ── Base de données (Supabase PostgreSQL) ────
# DATABASE_URL : pooler (port 6543) — utilisé par l'application
# DIRECT_URL   : connexion directe (port 5432) — utilisée par les migrations (prisma.config.ts)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres"

# ── Authentification ─────────────────────────
# Clé de signature des sessions (cookie fishcore-session). OBLIGATOIRE en production,
# min. 32 caractères. L'application refuse de démarrer en production sans elle.
JWT_SECRET="generate-with: openssl rand -base64 32"

# ── Supabase Storage ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Cloudinary (logos, images) ───────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Sécurité ────────────────────────────────
# Clé pour signer les liens d'installation des agences (obligatoire en production, min. 32 car.)
INSTALL_LINK_SECRET="generate-with: openssl rand -base64 32"

# ── App ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Tests d'intégration (npm test) ───────────
# Base PostgreSQL DÉDIÉE aux tests : elle est entièrement vidée à chaque exécution.
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/fishcore_test"
