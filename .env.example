# ─────────────────────────────────────────────
# fishcore — Variables d'environnement
# En local : copier en .env.local et remplir.
# Sur Vercel : Project → Settings → Environment Variables (mêmes noms).
# NE JAMAIS committer .env.local dans git.
# ─────────────────────────────────────────────

# ── Base de données (Supabase PostgreSQL) ────
# DATABASE_URL : pooler en mode TRANSACTION (port 6543) — utilisé par l'application
#   Supabase → Project Settings → Database → Connection string → « Transaction pooler »
# DIRECT_URL   : connexion SESSION / directe (port 5432) — migrations et garde-fous SQL
DATABASE_URL="postgresql://postgres.[ref]:[mot-de-passe]@aws-0-[region].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[ref]:[mot-de-passe]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Facultatif — vérification complète du certificat SSL de Supabase
# (Project Settings → Database → SSL Configuration → Download certificate ; coller le contenu,
#  retours à la ligne remplacés par \n). Sans elle, la connexion reste chiffrée.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Facultatif — connexions par instance (défaut : 5 sur Vercel, 10 ailleurs)
# DATABASE_POOL_MAX="5"

# ── Sécurité (OBLIGATOIRES en production, 32 caractères min.) ──
# Générer chacune avec : openssl rand -base64 32
JWT_SECRET=""
INSTALL_LINK_SECRET=""

# ── Application ──────────────────────────────
# Adresse publique (sert aux liens d'installation des agences)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Nom affiché (marque blanche)
NEXT_PUBLIC_APP_NAME="fishcore"

# ── Tests d'intégration (npm test) ───────────
# Base PostgreSQL DÉDIÉE aux tests : elle est entièrement vidée à chaque exécution.
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/fishcore_test"
