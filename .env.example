# ───────── Base de données ─────────
# PostgreSQL 14+ (Neon, Supabase, RDS, ou serveur dédié)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aurane?schema=public"

# ───────── Application ─────────
# URL publique, utilisée dans les emails (sans slash final)
APP_URL="https://www.votre-domaine.com"
# Secret de signature des sessions : 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# ───────── Stockage privé des justificatifs ─────────
# Dossier HORS du répertoire public, sur un volume persistant et sauvegardé.
STORAGE_DIR="./storage/private"

# ───────── Emails ─────────
# console (dev : affiche les emails dans le terminal) | resend | smtp
MAIL_PROVIDER="console"
MAIL_FROM="Votre Structure <no-reply@votre-domaine.com>"
# Adresse recevant les alertes internes (nouvelles demandes, messages de contact)
ADMIN_NOTIFY_EMAIL="operations@votre-domaine.com"
# Si MAIL_PROVIDER=resend
RESEND_API_KEY=""
# Si MAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ───────── Seed initial (création du super-administrateur) ─────────
SEED_ADMIN_EMAIL="admin@votre-domaine.com"
# 12 caractères minimum — à changer après la première connexion
SEED_ADMIN_PASSWORD=""

# ───────── Hébergement serverless (Vercel) ─────────
# "filesystem" (VPS) ou "database" (fichiers stockés en base, pour Vercel)
STORAGE_DRIVER="filesystem"
# Schéma PostgreSQL dédié (facultatif, ex. "aurane" sur une base partagée)
DATABASE_SCHEMA=""
DATABASE_POOL_SIZE="5"
