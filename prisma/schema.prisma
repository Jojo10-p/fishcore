// ═══════════════════════════════════════════════════════════════════
// fishcore — Schéma Prisma (PostgreSQL via Supabase)
// Gestion commerciale multi-métiers : poissonnerie, quincaillerie, matériaux,
// huile, supermarché, pharmacie… Le métier de l'entreprise (BusinessType)
// fixe les réglages par défaut ; tout reste paramétrable par produit.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : les URLs de connexion sont dans prisma.config.ts (migrations)
// et dans src/lib/prisma.ts (adaptateur pg à l'exécution).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────

enum UserRole {
  PLATFORM_ADMIN // Super admin de la plateforme
  COMPANY_OWNER // Propriétaire de l'entreprise
  CENTER_MANAGER // Gérant de centre/agence
  CASHIER // Caissier
  ACCOUNTANT // Comptable
  STOCK_MANAGER // Gestionnaire de stock
  SALES_EMPLOYEE // Employé vendeur
}

enum CenterStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CashRegisterState {
  ACTIVE
  INACTIVE
  OPEN
  CLOSED
}

/// Métier de l'entreprise : fixe les unités, catégories et options proposées
/// par défaut (voir src/lib/business-profiles.ts). Ne restreint rien.
enum BusinessType {
  GENERAL // Commerce général
  FISHMONGER // Poissonnerie
  HARDWARE // Quincaillerie
  BUILDING_MATERIALS // Matériaux de construction (maçonnerie)
  OIL_DISTRIBUTION // Vente d'huile / produits liquides
  LUBRICANTS // Huiles moteur & lubrifiants (moto, voiture, poids lourds)
  SUPERMARKET // Supermarché / alimentation générale
  PHARMACY // Pharmacie
  WHOLESALE // Grossiste / dépôt
}

/// Nature d'une unité : décide notamment si les quantités décimales ont un sens.
enum UnitKind {
  COUNT // pièce, unité, boîte…
  WEIGHT // kg, g, tonne
  VOLUME // L, mL
  LENGTH // m, cm
  AREA // m²
  PACKAGING // carton, sac, bidon, palette…
}

enum StockMovementType {
  RECEPTION // Réception fournisseur
  SALE // Vente
  CUSTOMER_RETURN // Retour client
  TRANSFER_IN // Transfert entrant
  TRANSFER_OUT // Transfert sortant
  LOSS // Perte
  DETERIORATION // Détérioration
  INVENTORY_ADJUST // Ajustement inventaire
  CORRECTION // Correction autorisée
}

enum PaymentMethod {
  CASH // Espèces
  MOBILE_MONEY // Mobile money (MTN, Moov...)
  CARD // Carte bancaire
  TRANSFER // Virement
  MIXED // Paiement mixte
  CREDIT // Historique uniquement : la vente à crédit n'est plus acceptée
}

enum InventoryStatus {
  IN_PROGRESS // Comptage en cours
  VALIDATED // Écarts appliqués au stock
  CANCELLED // Abandonné (aucun effet sur le stock)
}

enum TransferStatus {
  IN_TRANSIT // Parti du centre d'origine, pas encore réceptionné
  RECEIVED // Réceptionné à destination
  CANCELLED // Annulé avant réception : marchandise remise à l'origine
}

enum DeliveryStatus {
  PENDING // À servir
  PARTIAL // Servie en partie
  DELIVERED // Entièrement servie
}

enum QuoteStatus {
  OPEN // Valable (sauf si la date de validité est passée)
  CONVERTED // Transformé en vente
  CANCELLED // Annulé
}

enum SaleStatus {
  DRAFT // Brouillon
  COMPLETED // Finalisée
  CANCELLED // Annulée
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
}

enum CancellationStatus {
  PENDING // En attente d'approbation
  APPROVED // Approuvée
  REJECTED // Rejetée
}

enum DocumentType {
  QUOTE // Devis
  PURCHASE_ORDER // Bon de commande
  DELIVERY_NOTE // Bon de livraison
  RECEIPT_NOTE // Bon de réception
  INVOICE // Facture
  RECEIPT // Reçu de caisse
  CREDIT_NOTE // Avoir
  REFUND_RECEIPT // Justificatif de remboursement
}

enum SyncStatus {
  PENDING // En attente
  SYNCING // En cours
  SYNCED // Synchronisé
  FAILED // Échec
  CONFLICT // Conflit détecté
}

enum AuditEventType {
  // Auth
  USER_LOGIN
  USER_LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  PASSWORD_RESET_LINK_CREATED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  ACCOUNT_SIGNUP
  GOOGLE_LOGIN
  COMPANY_SUSPENDED
  COMPANY_REACTIVATED
  USER_UPDATED
  USER_REACTIVATED
  // Caisse
  CASH_SESSION_OPENED
  CASH_SESSION_CLOSED
  CASH_CLOSURE_VALIDATED
  CASH_MOVEMENT_RECORDED
  // Ventes
  SALE_CREATED
  SALE_CANCELLED
  SALE_REFUNDED
  // Annulations
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLATION_REJECTED
  // Stock
  STOCK_RECEIVED
  STOCK_ADJUSTED
  STOCK_TRANSFERRED
  STOCK_LOSS_RECORDED
  STOCK_RESERVED
  STOCK_RESERVATION_RELEASED
  // Inventaire
  INVENTORY_STARTED
  INVENTORY_VALIDATED
  INVENTORY_CANCELLED
  STOCK_TRANSFER_RECEIVED
  STOCK_TRANSFER_CANCELLED
  // Utilisateurs & Droits
  USER_CREATED
  USER_DEACTIVATED
  ROLE_CHANGED
  PERMISSION_CHANGED
  // Prix
  PRICE_CHANGED
  // Documents
  DOCUMENT_EXPORTED
  // Devis & retraits
  QUOTE_CREATED
  QUOTE_CANCELLED
  GOODS_DELIVERED
  // Finances
  EXPENSE_RECORDED
  EXPENSE_CANCELLED
  CUSTOMER_PAYMENT_RECEIVED
  SUPPLIER_PAYMENT_MADE
  PURCHASE_RECORDED
  // Entreprise
  COMPANY_SETTINGS_CHANGED
  // Agences
  CENTER_CREATED
  INSTALL_LINK_GENERATED
  INSTALL_LINK_USED
  // Système
  SYNC_COMPLETED
  SYNC_FAILED
  UNAUTHORIZED_ACCESS_ATTEMPT
  BACKUP_CREATED
}

// ─────────────────────────────────────────────
// PLATEFORME
// ─────────────────────────────────────────────

/// Entreprise cliente (locataire SaaS)
model Company {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identité
  tradeName  String // Nom commercial (affiché partout — white label)
  legalName  String? // Dénomination sociale
  logoUrl    String? // Adresse du logo (servi par /api/brand/…), versionnée
  brandAsset CompanyBrandAsset?
  ownerName  String
  phone      String
  email      String             @unique
  address    String?
  city       String?
  commune    String?
  country    String             @default("BJ")
  poBox      String?

  // Légal & fiscal
  taxId          String? // IFU
  tradeRegNumber String? // RCCM
  fiscalInfo     Json? // Infos fiscales complémentaires

  // Paramètres
  currency     String       @default("XOF")
  timezone     String       @default("Africa/Porto-Novo")
  businessType BusinessType @default(GENERAL)

  // Fiscalité : prix de vente affichés TTC ; la TVA est extraite du prix.
  vatEnabled        Boolean @default(false)
  defaultTaxRate    Decimal @default(0) @db.Decimal(5, 2) // ex. 18.00 (TVA Bénin)
  invoicePrefix     String  @default("FACT")
  invoiceCounter    Int     @default(1)
  quotePrefix       String  @default("DEV")
  quoteCounter      Int     @default(1)
  inventoryCounter  Int     @default(1)
  transferCounter   Int     @default(1)
  quoteValidityDays Int     @default(15)
  invoiceNotes      String? // Mentions en bas de facture (banque, conditions…)
  invoiceFormat     String  @default("TICKET_80") // Facture imprimée à la caisse : TICKET_80 (thermique) ou A4
  // Retrait au magasin : le client paie à la caisse puis se fait servir
  // sur présentation de sa facture (dépôts de matériaux, quincailleries…).
  requiresPickup    Boolean @default(false)

  // Statut
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  platformNotes   String? // Notes internes du créateur (jamais montrées au client)
  appName         String? // Nom de l'application installée (icône, fenêtre) ; vide = nom commercial

  // Relations
  centers       Center[]
  users         User[]
  products      Product[]
  categories    Category[]
  suppliers     Supplier[]
  customers     Customer[]
  auditLogs     AuditLog[]
  installLinks  AgencyInstallLink[]
  notifications Notification[]

  stockAlerts StockAlert[]
  invitations Invitation[]
  pushSubscriptions PushSubscription[]
  stockWatches StockWatch[]

  @@map("companies")
}

// ─────────────────────────────────────────────
// CENTRES / AGENCES
// ─────────────────────────────────────────────

/// Centre de vente / agence
model Center {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  code      String // Code unique interne
  address   String?
  city      String?
  phone     String?
  managerId String? // FK vers User (gérant)

  status CenterStatus @default(ACTIVE)

  // Relations
  users             UserCenter[] // Utilisateurs affectés à ce centre
  cashRegisters     CashRegister[]
  stocks            Stock[]
  receipts          GoodsReceipt[]
  purchases         Purchase[]
  transfers         StockTransfer[]
  incomingTransfers StockTransfer[]     @relation("TransferDestination")
  products          Product[] // articles propres à cette boutique
  expenses          Expense[]
  inventories       Inventory[]
  auditLogs         AuditLog[]
  installLinks      AgencyInstallLink[]

  stockAlerts StockAlert[]
  invitations Invitation[]
  stockWatches StockWatch[]

  @@unique([companyId, code])
  @@map("centers")
}

/// Lien d'installation pour une nouvelle agence
model AgencyInstallLink {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)

  token       String  @unique // Token signé (JWT)
  isUsed      Boolean @default(false)
  createdById String // Qui a généré le lien

  @@map("agency_install_links")
}

// ─────────────────────────────────────────────
// UTILISATEURS & AUTORISATIONS
// ─────────────────────────────────────────────

/// Compte utilisateur
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String? // null = plateforme admin
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  role         UserRole

  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  lastLoginAt   DateTime?
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?

  // Relations
  invitationsSent       Invitation[] @relation("InvitationCreator")
  invitationUsed        Invitation?  @relation("InvitationUser")
  googleSub             String?      @unique // identifiant Google (connexion avec Google)
  joinAttempts          Int          @default(0) // codes d'entreprise faux tapés d'affilée
  joinLockedUntil       DateTime?
  pushSubscriptions     PushSubscription[]
  centers               UserCenter[] // Centres autorisés
  cashSessions          CashSession[]
  sales                 Sale[]
  auditLogs             AuditLog[]
  cancellationRequests  Cancellation[]       @relation("CancellationRequester")
  cancellationApprovals Cancellation[]       @relation("CancellationApprover")
  sessions              AuthSession[]
  passwordResets        PasswordResetToken[]

  @@map("users")
}

/// Logo de l'entreprise : sert d'icône à l'application installée et d'en-tête
/// aux documents. Préparé dans le navigateur (carré, PNG) ; table à part pour ne
/// jamais charger les images avec la fiche entreprise.
model CompanyBrandAsset {
  companyId   String   @id
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  logo512     Bytes // PNG 512×512 (icône, documents)
  logo192     Bytes // PNG 192×192 (icône)
  maskable512 Bytes // PNG 512×512 avec marge (icône adaptative Android)

  @@map("company_brand_assets")
}

/// Compte entreprise supprimé par son propriétaire : la raison du départ et un
/// résumé de l'activité, conservés pour le créateur de la plateforme (toutes les
/// données de l'entreprise, elles, sont effacées).
model AccountDeletion {
  id               String    @id @default(cuid())
  deletedAt        DateTime  @default(now())
  companyId        String // Identifiant de l'entreprise supprimée (pour mémoire)
  tradeName        String
  ownerName        String
  email            String
  phone            String
  city             String?
  businessType     String
  companyCreatedAt DateTime
  reasons          String[] // Raisons cochées (codes)
  otherReason      String? // Raison écrite par le client
  centersCount     Int       @default(0)
  usersCount       Int       @default(0)
  productsCount    Int       @default(0)
  salesCount       Int       @default(0)
  salesTotal       Decimal   @default(0) @db.Decimal(14, 2)
  lastSaleAt       DateTime?

  @@index([deletedAt])
  @@map("account_deletions")
}

/// Lien de réinitialisation du mot de passe (sans e-mail : le responsable le
/// génère et l'envoie par WhatsApp/SMS). Seule l'empreinte du jeton est stockée.
model PasswordResetToken {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String? // null = généré par la plateforme (script)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Table de jointure Utilisateur ↔ Centre
model UserCenter {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId   String
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@unique([userId, centerId])
  @@map("user_centers")
}

/// Sessions d'authentification
model AuthSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?
  /// Dernière activité (mise à jour au plus une fois par minute) : « en ligne » pour la direction
  lastSeenAt   DateTime?

  @@index([lastSeenAt])
  @@map("auth_sessions")
}

// ─────────────────────────────────────────────
// PRODUITS & UNITÉS
// ─────────────────────────────────────────────

/// Produit (espèce de poisson, type de produit)
model Product {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Boutique à laquelle l'article est réservé (ex. huile d'arachide) ; vide = toutes les boutiques
  centerId String?
  center   Center? @relation(fields: [centerId], references: [id], onDelete: SetNull)

  name         String
  internalCode String? // Référence interne / SKU
  barcode      String? // Code-barres de l'unité de base
  brand        String? // Marque / fabricant / laboratoire
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description  String?
  // Caractéristiques libres selon le métier : {"Espèce":"Tilapia"},
  // {"Dosage":"500 mg","Forme":"Comprimé"}, {"Section":"12 mm"}…
  attributes   Json?

  // Options de suivi (préremplies par le profil métier, modifiables)
  trackBatches         Boolean @default(false) // Stock suivi par lot (FEFO à la vente)
  requiresExpiry       Boolean @default(false) // Date de péremption obligatoire à la réception
  requiresPrescription Boolean @default(false) // Rappel « sur ordonnance » à la caisse

  // TVA applicable (en %, incluse dans le prix de vente)
  taxRate Decimal @default(0) @db.Decimal(5, 2)

  // Unité principale
  baseUnitId String
  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])

  // Prix
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(12, 2)

  // Alertes
  stockAlertQty Decimal @default(0) @db.Decimal(12, 3)

  isActive Boolean @default(true)

  // Relations
  stocks          Stock[]
  saleLines       SaleLine[]
  quoteLines      QuoteLine[]
  receiptLines    GoodsReceiptLine[]
  priceHistory    ProductPriceHistory[]
  unitConversions UnitConversion[]
  batches         Batch[]
  inventoryLines  InventoryLine[]
  transferLines   StockTransferLine[]

  stockAlerts StockAlert[]
  stockWatches StockWatch[]

  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([centerId])
  @@map("products")
}

/// Catégorie de produits propre à chaque entreprise (rayon, famille…)
model Category {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([companyId, name])
  @@map("categories")
}

/// Unité de mesure
model Unit {
  id            String   @id @default(cuid())
  companyId     String? // null = unité globale plateforme
  name          String // "Kilogramme"
  symbol        String // "kg"
  isBaseUnit    Boolean  @default(false)
  kind          UnitKind @default(COUNT)
  allowsDecimal Boolean  @default(false) // 1,25 kg oui ; 1,25 pièce non

  products        Product[]        @relation("ProductBaseUnit")
  conversionsFrom UnitConversion[] @relation("ConversionFrom")
  conversionsTo   UnitConversion[] @relation("ConversionTo")

  @@unique([companyId, symbol])
  @@map("units")
}

/// Conversion entre unités (ex: 1 carton = 12.5 kg)
model UnitConversion {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromUnitId   String
  fromUnit     Unit     @relation("ConversionFrom", fields: [fromUnitId], references: [id])
  toUnitId     String
  toUnit       Unit     @relation("ConversionTo", fields: [toUnitId], references: [id])
  factor       Decimal  @db.Decimal(12, 6) // 1 fromUnit = factor toUnit (unité de base du produit)
  // Conditionnement vendable : prix propre (ex. carton de 12 moins cher que 12 pièces)
  // et code-barres propre (ex. code du carton en supermarché).
  sellingPrice Decimal? @db.Decimal(12, 2)
  barcode      String?

  @@unique([productId, fromUnitId])
  @@map("unit_conversions")
}

/// Historique des prix
model ProductPriceHistory {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  changedById   String

  @@map("product_price_history")
}

// ─────────────────────────────────────────────
// STOCKS
// ─────────────────────────────────────────────

/// Stock par produit et par centre
model Stock {
  id        String   @id @default(cuid())
  updatedAt DateTime @updatedAt

  centerId  String
  center    Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity    Decimal @default(0) @db.Decimal(12, 3) // Stock disponible total
  reservedQty Decimal @default(0) @db.Decimal(12, 3) // Réservé aux caisses offline
  avgCost     Decimal @default(0) @db.Decimal(14, 4) // Coût moyen pondéré (CMP) par unité de base
  version     Int     @default(0) // Verrou optimiste

  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([centerId, productId])
  @@map("stocks")
}

// Réserve de stock attribuée à une session de caisse avant une période hors
// connexion (cahier §9.4). La somme des réserves d'un stock = Stock.reservedQty,
// et ne peut jamais dépasser Stock.quantity.
model StockReservation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId String
  session   CashSession @relation(fields: [sessionId], references: [id])
  stockId   String
  stock     Stock       @relation(fields: [stockId], references: [id])

  quantity Decimal @db.Decimal(12, 3) // Quantité encore réservée (unité de base)

  @@unique([sessionId, stockId])
  @@map("stock_reservations")
}

/// Mouvement de stock (toute modification passe ici)
model StockMovement {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id])

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 3) // + entrant / - sortant
  unitId   String?
  batchId  String?
  batch    Batch?            @relation(fields: [batchId], references: [id])

  referenceType String? // "Sale", "GoodsReceipt", etc.
  referenceId   String? // ID de la vente / réception

  notes         String?
  performedById String
  centerId      String

  @@map("stock_movements")
}

/// Lot de marchandise
model Batch {
  id           String          @id @default(cuid())
  createdAt    DateTime        @default(now())
  receiptId    String?
  receipt      GoodsReceipt?   @relation(fields: [receiptId], references: [id])
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id])
  centerId     String?
  // Quantités dans l'unité de base du produit. remainingQty est décrémenté
  // à chaque vente (premier périmé, premier sorti).
  initialQty   Decimal?        @db.Decimal(12, 3)
  remainingQty Decimal         @default(0) @db.Decimal(12, 3)
  unitCost     Decimal?        @db.Decimal(14, 4) // Coût de revient unitaire (achat + frais annexes)
  lotNumber    String?
  packageCount Int?
  grossWeight  Decimal?        @db.Decimal(12, 3)
  receivedAt   DateTime        @default(now())
  expiresAt    DateTime?
  notes        String?
  movements    StockMovement[]

  @@index([productId, centerId, expiresAt])
  @@map("batches")
}

// ─────────────────────────────────────────────
// FOURNISSEURS & ACHATS
// ─────────────────────────────────────────────

/// Fournisseur
model Supplier {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  phone           String?
  email           String?
  address         String?
  taxId           String?
  isActive        Boolean @default(true)
  paymentTermDays Int     @default(0) // Délai de paiement accordé (échéance des factures)

  purchases Purchase[]
  receipts  GoodsReceipt[]
  payments  SupplierPayment[]

  @@map("suppliers")
}

/// Achat fournisseur
/// Achat fournisseur = dette (cahier §12). Créé à la validation d'une réception
/// rattachée à un fournisseur ; réglé par un ou plusieurs paiements.
model Purchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId  String
  centerId   String
  center     Center   @relation(fields: [centerId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  reference   String? // N° de facture fournisseur
  totalAmount Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?
  notes       String?
  createdById String

  receipts GoodsReceipt[]
  payments SupplierPayment[]

  @@index([companyId, supplierId])
  @@map("purchases")
}

/// Paiement à un fournisseur, imputé à ses factures les plus anciennes.
model SupplierPayment {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  companyId      String
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id])
  purchaseId     String? // Facture visée (sinon : la plus ancienne d'abord)
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  sessionId      String? // Payé en espèces depuis une caisse
  cashMovementId String?       @unique
  allocations    Json? // [{ purchaseId, amount }] : imputation réelle
  paidById       String
  notes          String?

  @@index([companyId, supplierId])
  @@map("supplier_payments")
}

/// Règlement d'un client sur ses achats à crédit (cahier §14 : créances).
/// Plage de numéros de facture confiée à une session de caisse.
/// La caisse numérote elle-même ses factures, avec ou sans connexion : le
/// ticket imprimé porte toujours le numéro définitif. À la clôture, les
/// numéros non utilisés sont rendus (sessionId vide) et réattribués en priorité.
model InvoiceNumberBlock {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  companyId  String
  prefix     String
  first      Int
  last       Int
  sessionId  String?
  releasedAt DateTime?

  @@index([companyId, sessionId])
  @@map("invoice_number_blocks")
}

/// Devis : proposition de prix, transformée en vente à la caisse
model Quote {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  companyId      String
  centerId       String
  number         String
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  createdById    String
  status         QuoteStatus @default(OPEN)
  validUntil     DateTime
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  notes          String?
  saleId         String?     @unique
  sale           Sale?       @relation(fields: [saleId], references: [id])
  cancelledAt    DateTime?
  cancelReason   String?
  lines          QuoteLine[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
  @@map("quotes")
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position  Int
  productId String
  product   Product @relation(fields: [productId], references: [id])
  unitId    String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2) // Remise par unité
  lineTotal Decimal @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  @@map("quote_lines")
}

/// Retrait de marchandise au magasin (bon de sortie), total ou partiel
model Delivery {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  companyId     String
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id])
  deliveredById String
  number        Int // N° de bon pour cette vente (1, 2…)
  notes         String?
  lines         DeliveryLine[]

  @@unique([saleId, number])
  @@index([companyId, createdAt])
  @@map("deliveries")
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  saleLineId String
  quantity   Decimal  @db.Decimal(12, 3)

  @@map("delivery_lines")
}

/// Réception de marchandises
model GoodsReceipt {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centerId   String
  center     Center    @relation(fields: [centerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  reference     String?
  receivedAt    DateTime  @default(now())
  isValidated   Boolean   @default(false) // Validation = augmentation du stock
  validatedAt   DateTime?
  validatedById String?

  transportCost Decimal @default(0) @db.Decimal(12, 2)
  iceCost       Decimal @default(0) @db.Decimal(12, 2)
  handlingCost  Decimal @default(0) @db.Decimal(12, 2)
  otherCosts    Decimal @default(0) @db.Decimal(12, 2)

  notes       String?
  createdById String

  // Brouillon (sauvegarde progressive)
  isDraft   Boolean @default(true)
  draftData Json?

  lines   GoodsReceiptLine[]
  batches Batch[]

  @@map("goods_receipts")
}

/// Ligne de réception
model GoodsReceiptLine {
  id        String       @id @default(cuid())
  receiptId String
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id])

  packageCount   Int? // Nombre de colis (cartons, sacs, bidons…)
  grossWeight    Decimal?  @db.Decimal(12, 3) // Poids brut, si pertinent
  quantity       Decimal   @db.Decimal(12, 3) // Quantité reçue dans l'unité de base
  unitId         String?
  unitPrice      Decimal   @db.Decimal(12, 2) // Coût par unité de base
  totalPrice     Decimal   @db.Decimal(12, 2)
  landedUnitCost Decimal?  @db.Decimal(14, 4) // Coût de revient : prix + part des frais (calculé à la validation)
  lotNumber      String?
  expiresAt      DateTime?

  @@map("goods_receipt_lines")
}

// ─────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  taxId     String? // IFU du client (facture à une entreprise)
  sales     Sale[]
  quotes    Quote[]

  @@index([companyId, name])
  @@map("customers")
}

// ─────────────────────────────────────────────
// CAISSES & SESSIONS
// ─────────────────────────────────────────────

/// Caisse enregistreuse
model CashRegister {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  name     String
  state    CashRegisterState @default(ACTIVE)
  isActive Boolean           @default(true)

  sessions CashSession[]

  @@map("cash_registers")
}

/// Session de caisse (shift d'un caissier)
model CashSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  cashierId      String
  cashier        User         @relation(fields: [cashierId], references: [id])

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingBalance     Decimal  @db.Decimal(12, 2) // Fond de caisse déclaré
  closingBalance     Decimal? @db.Decimal(12, 2) // Montant réellement compté
  theoreticalBalance Decimal? @db.Decimal(12, 2) // Calculé par le système
  discrepancy        Decimal? @db.Decimal(12, 2) // Écart

  isValidated   Boolean @default(false)
  validatedById String?
  notes         String?

  // Connexion au moment de l'ouverture
  deviceId        String?
  connectionState String?

  sales         Sale[]
  cashMovements CashMovement[]
  closure       CashClosure?
  reservations  StockReservation[]
  refunds       Refund[]

  @@map("cash_sessions")
}

/// Mouvement de caisse (sortie autorisée, fond d'appoint, etc.)
model CashMovement {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  sessionId     String
  session       CashSession @relation(fields: [sessionId], references: [id])
  type          String // "CASH_OUT", "CASH_IN", "ADVANCE"
  amount        Decimal     @db.Decimal(12, 2)
  reason        String
  approvedById  String?
  performedById String

  @@map("cash_movements")
}

/// Clôture de caisse (historique immuable)
model CashClosure {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId String      @unique
  session   CashSession @relation(fields: [sessionId], references: [id])

  openingBalance     Decimal @db.Decimal(12, 2)
  totalSales         Decimal @db.Decimal(12, 2)
  totalCash          Decimal @db.Decimal(12, 2)
  totalMobileMoney   Decimal @db.Decimal(12, 2)
  totalCard          Decimal @db.Decimal(12, 2)
  totalOther         Decimal @db.Decimal(12, 2)
  totalRefunds       Decimal @db.Decimal(12, 2)
  totalCashOut       Decimal @db.Decimal(12, 2)
  theoreticalBalance Decimal @db.Decimal(12, 2)
  declaredBalance    Decimal @db.Decimal(12, 2)
  discrepancy        Decimal @db.Decimal(12, 2)

  cashierId     String
  validatedById String?
  notes         String?

  @@map("cash_closures")
}

// ─────────────────────────────────────────────
// VENTES
// ─────────────────────────────────────────────

/// Vente
model Sale {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clé d'idempotence (anti-doublon sync offline)
  idempotencyKey String @unique

  companyId  String
  centerId   String
  sessionId  String
  session    CashSession @relation(fields: [sessionId], references: [id])
  cashierId  String
  cashier    User        @relation(fields: [cashierId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  customerName String? // nom du client tapé à la caisse (facultatif)

  saleNumber String // Numéro affiché (unique par entreprise)
  invoiceSeq Int? // Partie numérique du numéro (sans trou ni doublon)
  status     SaleStatus @default(COMPLETED)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2) // TTC
  taxAmount      Decimal @default(0) @db.Decimal(12, 2) // TVA incluse dans le total

  notes String?

  // Espèces : montant remis par le client et monnaie rendue (imprimés sur le ticket)
  amountTendered Decimal? @db.Decimal(12, 2)
  changeGiven    Decimal? @db.Decimal(12, 2)

  // Retrait de la marchandise (si l'entreprise sert sur présentation de la facture)
  deliveryStatus DeliveryStatus @default(DELIVERED)

  // Offline
  createdOffline Boolean   @default(false)
  deviceId       String?
  syncedAt       DateTime?

  lines         SaleLine[]
  payments      Payment[]
  cancellations Cancellation[]
  refunds       Refund[]
  documents     Document[]
  deliveries    Delivery[]
  quote         Quote?

  @@unique([companyId, saleNumber])
  @@unique([companyId, invoiceSeq])
  @@index([companyId, centerId, createdAt])
  @@map("sales")
}

/// Ligne de vente
model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity          Decimal @db.Decimal(12, 3)
  unitId            String?
  unitPrice         Decimal @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal @db.Decimal(12, 2) // TTC
  baseQuantity      Decimal @default(0) @db.Decimal(12, 3) // Quantité sortie du stock (unité de base)
  taxRate           Decimal @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  costAmount        Decimal @default(0) @db.Decimal(12, 2) // Coût de revient des marchandises vendues (figé à la vente)
  deliveredQuantity Decimal @default(0) @db.Decimal(12, 3) // Quantité remise au client (unité vendue)

  @@map("sale_lines")
}

/// Paiement
model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Idempotence
  idempotencyKey String @unique

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // Référence mobile money, etc.
  notes     String?

  @@map("payments")
}

// ─────────────────────────────────────────────
// ANNULATIONS & REMBOURSEMENTS
// ─────────────────────────────────────────────

/// Demande d'annulation d'une vente
model Cancellation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  requesterId String // Qui demande
  requester   User    @relation("CancellationRequester", fields: [requesterId], references: [id])
  approverId  String? // Qui approuve (≠ demandeur obligatoire)
  approver    User?   @relation("CancellationApprover", fields: [approverId], references: [id])

  status          CancellationStatus @default(PENDING)
  requestReason   String
  rejectionReason String?

  decidedAt   DateTime?
  stockImpact Json? // Détail des mouvements de stock liés
  cashImpact  Decimal?  @db.Decimal(12, 2)

  @@map("cancellations")
}

/// Remboursement
model Refund {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])
  // Session de caisse d'où l'argent est sorti (null = remboursement hors caisse,
  // ex. mobile money rendu à distance). Sert au calcul de la clôture.
  sessionId     String?
  session       CashSession?  @relation(fields: [sessionId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reason        String
  approvedById  String
  performedById String

  @@map("refunds")
}

// ─────────────────────────────────────────────
// INVENTAIRES
// ─────────────────────────────────────────────

model Inventory {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId     String
  number        String // INV-000001
  centerId      String
  center        Center          @relation(fields: [centerId], references: [id])
  status        InventoryStatus @default(IN_PROGRESS)
  label         String? // « Inventaire annuel », « Rayon congelés »…
  startedById   String
  validatedById String?
  validatedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  notes         String?

  lines InventoryLine[]

  @@unique([companyId, number])
  @@index([centerId, status])
  @@map("inventories")
}

/// Ligne d'inventaire. theoreticalQty est relu au moment du comptage : l'écart
/// (compté − théorique) est appliqué à la validation, sans compter deux fois les
/// ventes faites entre-temps.
model InventoryLine {
  id                String    @id @default(cuid())
  inventoryId       String
  inventory         Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  theoreticalQty    Decimal   @db.Decimal(12, 3)
  countedQty        Decimal?  @db.Decimal(12, 3) // null = pas encore compté
  discrepancy       Decimal?  @db.Decimal(12, 3)
  unitCost          Decimal   @default(0) @db.Decimal(14, 4) // CMP au moment du comptage (valorisation de l'écart)
  discrepancyReason String?
  countedAt         DateTime?
  countedById       String?

  @@unique([inventoryId, productId])
  @@map("inventory_lines")
}

// ─────────────────────────────────────────────
// TRANSFERTS INTER-CENTRES
// ─────────────────────────────────────────────

model StockTransfer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId      String
  number         String // TR-000001
  fromCenterId   String
  fromCenter     Center         @relation(fields: [fromCenterId], references: [id])
  toCenterId     String
  toCenter       Center         @relation("TransferDestination", fields: [toCenterId], references: [id])
  status         TransferStatus @default(IN_TRANSIT)
  notes          String?
  createdById    String // Expédié par (le stock part à la création)
  receivedById   String?
  receivedAt     DateTime?
  receptionNotes String?
  cancelledById  String?
  cancelledAt    DateTime?

  lines StockTransferLine[]

  @@unique([companyId, number])
  @@index([fromCenterId, status])
  @@index([toCenterId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3) // Expédié (unité de base)
  receivedQty Decimal?      @db.Decimal(12, 3) // Reçu (null tant que non réceptionné)
  unitId      String?
  unitCost    Decimal       @default(0) @db.Decimal(14, 4) // CMP du centre d'origine
  /// Lots expédiés (produits suivis par lot) : [{ lotNumber, expiresAt, quantity, unitCost }]
  batches     Json?

  @@map("stock_transfer_lines")
}

// ─────────────────────────────────────────────
// DÉPENSES
// ─────────────────────────────────────────────

/// Dépense de l'entreprise (cahier §14). Jamais supprimée : une erreur se corrige
/// par annulation historisée. Payée en espèces depuis une caisse ouverte, elle
/// crée une sortie de caisse (prise en compte à la clôture).
model Expense {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  companyId      String
  centerId       String
  center         Center        @relation(fields: [centerId], references: [id])
  category       String // Loyer, Électricité, Salaires, Transport…
  amount         Decimal       @db.Decimal(12, 2)
  description    String?
  date           DateTime      @default(now()) // Date de la dépense (peut différer de la saisie)
  method         PaymentMethod @default(CASH)
  reference      String? // N° de facture, référence mobile money…
  payee          String? // Bénéficiaire
  sessionId      String? // Caisse d'où l'argent est sorti
  cashMovementId String?       @unique
  createdById    String

  isCancelled   Boolean   @default(false)
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  @@index([companyId, date])
  @@map("expenses")
}

// ─────────────────────────────────────────────
// DOCUMENTS COMMERCIAUX
// ─────────────────────────────────────────────

model Document {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now())
  companyId  String
  centerId   String?
  saleId     String?
  sale       Sale?        @relation(fields: [saleId], references: [id])
  type       DocumentType
  number     String       @unique
  pdfUrl     String?
  data       Json // Snapshot des données au moment de la création
  isVoided   Boolean      @default(false)
  voidedAt   DateTime?
  voidedById String?

  @@map("documents")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

/// Alerte de stock bas : ouverte quand un article descend à son seuil dans un
/// centre, fermée d'elle-même quand le stock remonte au-dessus (réception…).
/// Une seule alerte ouverte par (centre, article) — index partiel dans integrity-guards.sql.
model StockAlert {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  centerId   String
  center     Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Decimal   @db.Decimal(12, 3) // stock restant (mis à jour tant que l'alerte est ouverte)
  threshold  Decimal   @db.Decimal(12, 3) // seuil d'alerte au moment de l'alerte
  readAt     DateTime? // vue par le propriétaire
  emailedAt  DateTime? // e-mail envoyé au(x) propriétaire(s)
  emailError String?
  resolvedAt DateTime? // stock remonté au-dessus du seuil

  @@index([companyId, resolvedAt])
  @@index([centerId, productId])
  @@map("stock_alerts")
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  centerId  String?
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?

  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// SYNCHRONISATION OFFLINE
// ─────────────────────────────────────────────

/// File d'opérations à synchroniser
model SyncOperation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  centerId  String?
  deviceId  String

  idempotencyKey String     @unique // Clé anti-doublon
  operationType  String // "SALE", "RECEIPT", etc.
  payload        Json // Données de l'opération
  status         SyncStatus @default(PENDING)
  attempts       Int        @default(0)
  lastError      String?
  resolvedAt     DateTime?
  dependsOn      String? // ID d'une autre SyncOperation

  @@map("sync_operations")
}

// ─────────────────────────────────────────────
// JOURNAL D'AUDIT (protégé — jamais modifiable)
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  centerId  String?
  center    Center?  @relation(fields: [centerId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  eventType     AuditEventType
  referenceType String? // "Sale", "CashSession", etc.
  referenceId   String?

  // Timestamps double (appareil + serveur)
  deviceTimestamp DateTime?
  serverTimestamp DateTime  @default(now())

  result    String? // "SUCCESS", "FAILED", "DENIED"
  reason    String?
  oldValues Json?
  newValues Json?
  metadata  Json?

  // Intégrité : hash du log précédent (chaîne de hachage)
  previousHash String?
  hash         String?

  ipAddress String?
  userAgent String?
  deviceId  String?
  sessionId String?

  @@index([companyId, serverTimestamp])
  @@map("audit_logs")
}

// Téléphones (ou ordinateurs) abonnés aux notifications : gérant et patron
model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  @@index([companyId])
  @@map("push_subscriptions")
}

// Suivi du stock de chaque article (par boutique) pour les notifications :
// « moitié vendue » depuis le dernier ajout, puis « presque épuisé » à chaque vente sous le seuil.
model StockWatch {
  id             String    @id @default(cuid())
  updatedAt      DateTime  @updatedAt
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  centerId       String
  center         Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  lastQty        Decimal   @db.Decimal(12, 3) // stock vu à la dernière vérification
  refQty         Decimal   @db.Decimal(12, 3) // stock juste après le dernier ajout
  halfNotifiedAt DateTime? // notification « moitié vendue » déjà envoyée
  lowNotifiedQty Decimal?  @db.Decimal(12, 3) // dernière quantité signalée sous le seuil

  @@unique([centerId, productId])
  @@index([companyId])
  @@map("stock_watches")
}

// Lien d'invitation : la direction choisit le rôle et la boutique, l'employé crée
// lui-même son compte en ouvrant le lien (WhatsApp, SMS…). Usage unique.
model Invitation {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  centerId    String?
  center      Center?   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  role        UserRole
  label       String? // nom prévu (« Rachidi »), pour s'y retrouver
  tokenHash   String    @unique
  createdById String?
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  usedById    String?   @unique
  usedBy      User?     @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt   DateTime?

  @@index([companyId, usedAt])
  @@map("invitations")
}

// Suggestions d'articles (liste fournie par GJH) : proposées quand on tape le nom
// d'un article à l'ajout de stock. Ce ne sont pas des articles du catalogue.
model ProductSuggestion {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  name           String   @unique
  liters         Decimal? @db.Decimal(8, 3) // contenance d'une unité (bidon, bouteille)
  unitsPerCarton Int? // nombre d'unités dans un carton
  category       String?
  /// Boutique concernée (huile de moteur, huile d'arachide…) ; vide = toutes
  centerId       String?

  @@index([centerId])
  @@map("product_suggestions")
}
